{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
  "python.analysis.extraPaths": ["${workspaceFolder}"],

  // Give the Red Hat YAML extension the canonical GitHub Actions schema for
  // workflow files (correct hover / completion / validation).
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": [
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml"
    ]
  }

  // NOTE: the "Expected a scalar value..." and "Unable to find reusable workflow"
  // diagnostics some editors show on these workflows come from an OUTDATED
  // `github.vscode-github-actions` extension (its bundled @actions/workflow-parser).
  // The current parser, actionlint, and the canonical schema all validate these
  // files with zero errors. Fix: update that extension. CI's actionlint job is the
  // authoritative validator.
}
