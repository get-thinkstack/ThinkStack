#!/bin/bash
# pre-commit: fast, local-only sanity. Must stay under ~2 seconds.
#
# Deliberately light. Committing is not the place to run the full suite - that
# happens in pre-push, right before code can actually affect anyone else. This
# only catches things that make a commit obviously bad.
#
# bypass once:  git commit --no-verify
set -uo pipefail

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; NC='\033[0m'
FAIL=0

STAGED="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)"
[ -z "$STAGED" ] && exit 0

# ── 1. never commit a secret ────────────────────────────────
# the updater private key is unrecoverable if it leaks: anyone holding it can
# sign updates your users' apps will trust and install.
SECRETS="$(echo "$STAGED" | grep -E '\.(key|pem|p12|pfx)$|(^|/)\.env$|updater.*password' || true)"
if [ -n "$SECRETS" ]; then
    echo -e "${RED}✗ refusing to commit files that look like secrets:${NC}"
    while IFS= read -r s; do echo "    $s"; done <<< "$SECRETS"
    echo -e "  if this is intentional: ${CYAN}git commit --no-verify${NC}"
    FAIL=1
fi

# private key material pasted into an otherwise-normal file
if git diff --cached -U0 2>/dev/null | grep -qE '^\+.*(BEGIN [A-Z ]*PRIVATE KEY|untrusted comment: .*secret key)'; then
    echo -e "${RED}✗ a private key appears in the staged diff${NC}"
    FAIL=1
fi

# ── 2. python must parse ────────────────────────────────────
# CI freezes with 3.12; syntax a newer local python accepts (3.14 template
# strings, say) is a hard SyntaxError there. Prefer 3.12 when it exists.
PY="python3"
command -v python3.12 >/dev/null 2>&1 && PY="python3.12"
PYFILES="$(echo "$STAGED" | grep '\.py$' || true)"
if [ -n "$PYFILES" ]; then
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        if ! $PY -m py_compile "$f" 2>/dev/null; then
            echo -e "${RED}✗ syntax error (${PY}): ${f}${NC}"
            $PY -m py_compile "$f" 2>&1 | tail -3 | sed 's/^/    /'
            FAIL=1
        fi
    done <<< "$PYFILES"
fi

# ── 3. config files must parse ──────────────────────────────
while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in
        *.json)
            python3 -c "import json,sys;json.load(open(sys.argv[1]))" "$f" 2>/dev/null || {
                echo -e "${RED}✗ invalid JSON: ${f}${NC}"; FAIL=1; }
            ;;
        .github/workflows/*.yml|.github/workflows/*.yaml)
            python3 -c "import yaml,sys;yaml.safe_load(open(sys.argv[1]))" "$f" 2>/dev/null || {
                echo -e "${RED}✗ invalid YAML: ${f}${NC}"; FAIL=1; }
            # the GitHub Actions VSCode extension chokes on non-ASCII in
            # workflows; keep them plain so the Problems panel stays clean.
            if LC_ALL=C grep -qP '[^\x00-\x7F]' "$f" 2>/dev/null; then
                echo -e "${YELLOW}!${NC} non-ASCII characters in ${f} (use -- not an em dash)"
            fi
            ;;
    esac
done <<< "$STAGED"

# ── 4. merge conflict markers ───────────────────────────────
if git diff --cached -U0 2>/dev/null | grep -qE '^\+(<<<<<<<|>>>>>>>)( |$)'; then
    echo -e "${RED}✗ unresolved merge conflict markers in the staged diff${NC}"
    FAIL=1
fi

if [ "$FAIL" -ne 0 ]; then
    echo -e "${RED}pre-commit failed.${NC}"
    exit 1
fi
echo -e "${GREEN}✓ pre-commit ok${NC}"
