{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, including the backend-served UI",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8000/*",
      "http://localhost:8000/*",
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default"
  ]
}
