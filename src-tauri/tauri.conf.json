{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThinkStack",
  "version": "0.1.1",
  "identifier": "com.thinkstack.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ThinkStack",
        "url": "loading.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist/thinkstack-api/": "api/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/get-thinkstack/ThinkStack/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQkQ0QjFBNUEyQkQzRTEKUldUaDB5dGFHa3U5M2N0SytrQXlrWW1wbUhXNlZ1S1ZQeHQ5dE43aWNQQVpjNW9oSGpmWDgzMkQK"
    }
  }
}
