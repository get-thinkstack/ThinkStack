# copy this file to .env and adjust for your machine (.env is gitignored).
# these override the defaults in config.py via the THINKSTACK_ prefix.

# llm runtime: "llama_cpp" (local gguf) or "ollama"
# THINKSTACK_LLM_PROVIDER=llama_cpp

# path to a .gguf file, OR a directory containing one or more .gguf files.
# point at a specific file to pin exactly which model loads.
# THINKSTACK_LLM_MODEL_PATH=data/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf

# gpu offload: -1 = all layers on GPU (needs a CUDA build of llama-cpp-python),
# 0 = CPU-only. when non-zero, the app refuses to fall back to CPU.
# CUDA build:
#   pip install llama-cpp-python --force-reinstall --no-deps \
#     --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cu124
# THINKSTACK_LLM_GPU_LAYERS=-1

# context window (tokens) for analysis prompts.
# THINKSTACK_LLM_CTX_SIZE=4096
